// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  /// App / Prisma Client (Supabase pooler :6543 is OK)
  url       = env("DATABASE_URL")
  /// Migrations & introspection — must be direct Postgres (:5432), not PgBouncer
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  username     String        @unique
  email        String        @unique
  passwordHash String
  authProvider String        @default("credentials")
  googleId     String?       @unique
  profileImageUrl String?
  emailVerifiedAt DateTime?
  role         Role          @default(STUDENT)
  lastLoginAt  DateTime?
  sessionVersion Int        @default(0)
  createdAt    DateTime      @default(now())
  quizzes      Quiz[]
  results      Result[]
  quizSessions QuizSession[]
  remedialQuizSessions RemedialQuizSession[]
}

model EmailSignupVerification {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  fullName     String
  passwordHash String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([username])
  @@index([expiresAt])
}

model Quiz {
  id          String     @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime   @default(now())
  isPublished Boolean    @default(false)
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  jsonBlobUrl String?
  /// When set (with scheduledEnd), quiz is only available in this window (UTC).
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  /// Bcrypt hash; null means no password required to open the quiz.
  accessPasswordHash String?
  /// If false, each student may submit only once. If true, unlimited attempts.
  allowMultipleAttempts Boolean @default(false)
  /// Enable shuffling for student attempts
  shuffleQuestions      Boolean @default(false)
  shuffleOptions        Boolean @default(false)
  /// Per-attempt time limit (minutes). Null = no limit. Timer starts on first load after passing gates; session persists across logins.
  timeLimitMinutes      Int?
  questions             Question[]
  results               Result[]
  quizSessions          QuizSession[]
  remedialQuizSessions  RemedialQuizSession[]
  updatedAt             DateTime @updatedAt @default(now())

  @@index([isPublished, createdAt])
  @@index([createdById, createdAt])
}

model Question {
  id            String @id @default(uuid())
  quizId        String
  questionText  String
  options       Json
  correctAnswer String
  explanation   String?
  order         Int
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model Result {
  id          String   @id @default(uuid())
  quizId      String
  studentId   String
  score       Int
  total       Int
  timeTaken   Int?
  userAnswers Json
  titleOverride String?
  questionIds Json?
  sourceResultId String?
  attemptType String @default("NORMAL")
  createdAt   DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id])
  remedialQuizSessions RemedialQuizSession[]

  @@index([quizId, studentId, attemptType])
  @@index([quizId, attemptType])
  @@index([studentId, createdAt])
}

/// One row per timed attempt in progress (`submittedAt` null) or historical marker after submit/expiry.
model QuizSession {
  id             String    @id @default(uuid())
  quizId         String
  studentId      String
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  currentAnswers Json?
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
  @@index([quizId, studentId, submittedAt])
  @@index([studentId, submittedAt])
}

model RemedialQuizSession {
  id             String    @id @default(uuid())
  sourceResultId String
  quizId         String
  studentId      String
  questionIds    Json
  currentAnswers Json?
  resultId       String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt @default(now())
  sourceResult   Result    @relation(fields: [sourceResultId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([sourceResultId, studentId])
  @@index([quizId, studentId])
  @@index([resultId])
}

model QuizListEvent {
  id        String   @id @default(uuid())
  quizId    String?
  action    String
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([quizId])
}

model ResultListEvent {
  id        String   @id @default(uuid())
  quizId    String?
  resultId  String?
  action    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([quizId])
  @@index([resultId])
}

model RoleChangeEvent {
  id           String   @id @default(uuid())
  targetUserId String
  actorId      String?
  action       String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId])
}
